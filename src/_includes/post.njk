---
layout: base.njk
exactTitle: true
---
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-date"><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% if updated | isLaterDay(date) %}<span>Updated {{ updated | readableDate }}</span>{% endif %}</p>
    {% if tags.length %}<ul class="post-labels" aria-label="Labels">{% for label in tags %}<li><a href="/search/label/{{ label | urlencode }}/">{{ label }}</a></li>{% endfor %}</ul>{% endif %}
  </header>
  <div class="post-body"><!--BODY-START-->{{ content | safe }}<!--BODY-END--></div>
  {% set adjacent = collections.posts | neighbors(page.url) %}
  <nav class="post-navigation" aria-label="Post navigation">
    {% if adjacent.previous %}<a rel="prev" href="{{ adjacent.previous.url }}"><span>Previous</span>{{ adjacent.previous.data.title }}</a>{% endif %}
    {% if adjacent.next %}<a rel="next" href="{{ adjacent.next.url }}"><span>Next</span>{{ adjacent.next.data.title }}</a>{% endif %}
  </nav>
</article>
